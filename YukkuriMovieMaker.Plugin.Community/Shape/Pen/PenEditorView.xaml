<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Shape.Pen.PenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Shape.Pen"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:project="clr-namespace:YukkuriMovieMaker.Project;assembly=YukkuriMovieMaker.Plugin"
             xmlns:focus="clr-namespace:YukkuriMovieMaker.Plugin.Community.Effect.Video.Container"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition MinWidth="200"/>
            <ColumnDefinition Width="6"/>
            <ColumnDefinition x:Name="layerColumn" Width="240" MinWidth="160"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="3">
            <Grid.Resources>
                <Style x:Key="ToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <ContextMenu x:Key="PenContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.Pressure}" Command="{Binding TogglePenPressure}" IsChecked="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.IsPressure}"/>
                    <MenuItem Header="{x:Static local:Texts.Stabilization}">
                        <MenuItem Header="{x:Static local:Texts.StabilizationNone}" Command="{Binding SetPenStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.None}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.Stabilization}" Value="None">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationLow}" Command="{Binding SetPenStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.Low}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.Stabilization}" Value="Low">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationMedium}" Command="{Binding SetPenStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.Medium}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.Stabilization}" Value="Medium">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationHigh}" Command="{Binding SetPenStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.High}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.Stabilization}" Value="High">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </MenuItem>
                </ContextMenu>
                <ContextMenu x:Key="HighlighterContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.Pressure}" Command="{Binding ToggleHighlighterPressure}" IsChecked="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.IsPressure}"/>
                    <MenuItem Header="{x:Static local:Texts.Stabilization}">
                        <MenuItem Header="{x:Static local:Texts.StabilizationNone}" Command="{Binding SetHighlighterStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.None}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.Stabilization}" Value="None">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationLow}" Command="{Binding SetHighlighterStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.Low}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.Stabilization}" Value="Low">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationMedium}" Command="{Binding SetHighlighterStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.Medium}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.Stabilization}" Value="Medium">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                        <MenuItem Header="{x:Static local:Texts.StabilizationHigh}" Command="{Binding SetHighlighterStabilizationCommand}" CommandParameter="{x:Static local:PenStabilization.High}">
                            <MenuItem.Style>
                                <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                    <Setter Property="IsChecked" Value="False"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.Stabilization}" Value="High">
                                            <Setter Property="IsChecked" Value="True"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </MenuItem.Style>
                        </MenuItem>
                    </MenuItem>
                </ContextMenu>
                <ContextMenu x:Key="EraserContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.EraserByPoint}" Command="{Binding SelectEraserByPointCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=EraserStyle.Mode}" Value="Point">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="{x:Static local:Texts.EraserByStroke}" Command="{Binding SelectEraserByStrokeCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=EraserStyle.Mode}" Value="Line">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                </ContextMenu>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition MaxWidth="100" MinWidth="26"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="52"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Command="{Binding SelectPenCommand}" ContextMenu="{StaticResource PenContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Pen}}"
                          ToolTip="{x:Static local:Texts.BallPen}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Pen">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="1" Padding="0" FontSize="5" ContextMenu="{StaticResource PenContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <ToggleButton Grid.Column="2" Command="{Binding SelectHighlighterCommand}" ContextMenu="{StaticResource HighlighterContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Marker}}"
                          ToolTip="{x:Static local:Texts.Highlighter}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Highlighter">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="3" Padding="0" FontSize="5" ContextMenu="{StaticResource HighlighterContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <ToggleButton Grid.Column="4" Command="{Binding SelectEraserCommand}" ContextMenu="{StaticResource EraserContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Eraser}}"
                          ToolTip="{x:Static local:Texts.Eraser}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Eraser">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="5" Padding="0" FontSize="5" ContextMenu="{StaticResource EraserContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <ToggleButton Grid.Column="6" Command="{Binding SelectSelectionCommand}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Lasso}}"
                          ToolTip="{x:Static local:Texts.Select}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Select">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <RepeatButton Grid.Column="7" Padding="4" Command="{Binding UndoCommand}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Undo}}"
                          ToolTip="{x:Static local:Texts.Undo}"/>
            <RepeatButton Grid.Column="8" Padding="4" Command="{Binding RedoCommand}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Redo}}"
                          ToolTip="{x:Static local:Texts.Redo}"/>
            <controls:ColorPicker Grid.Column="9" Value="{Binding StrokeColor,Mode=TwoWay}"
                                  ToolTip="{x:Static local:Texts.StrokeColor}">
                <controls:ColorPicker.Style>
                    <Style TargetType="controls:ColorPicker" BasedOn="{StaticResource {x:Type controls:ColorPicker}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Eraser">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ColorPicker.Style>
            </controls:ColorPicker>
            <controls:TextBoxSlider Grid.Column="10" Value="{Binding StrokeThickness,Mode=TwoWay}"
                                    Min="0.1" Max="1024" DefaultMin="0.1" DefaultMax="10"
                                    ToolTip="{x:Static local:Texts.Thickness}"/>
            <Button Grid.Column="11" Command="{Binding ImportIsfCommand}"
                    Content="{DynamicResource {x:Static icons:IconKeys.Import}}"
                    ToolTip="{x:Static local:Texts.Import}"/>
            <controls:DropDownButton Grid.Column="12" Padding="4"
                                     Content="{DynamicResource {x:Static icons:IconKeys.Export}}"
                                     ToolTip="{x:Static local:Texts.Export}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
                <controls:DropDownButton.ContextMenu>
                    <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}">
                        <MenuItem Header="{x:Static local:Texts.SaveImage}" Command="{Binding SaveImageCommand}"/>
                        <MenuItem Header="{x:Static local:Texts.ExportAsIsf}" Command="{Binding ExportIsfCommand}"/>
                    </ContextMenu>
                </controls:DropDownButton.ContextMenu>
            </controls:DropDownButton>
            <Button Grid.Column="13" Click="OnFitToScreenClick"
                    Content="{DynamicResource {x:Static icons:IconKeys.FitToScreen}}"
                    ToolTip="{x:Static local:Texts.FitToScreen}"/>
            <TextBlock Grid.Column="14" VerticalAlignment="Center" HorizontalAlignment="Right" Padding="0,0,4,0"
                       Text="{Binding ElementName=canvas, Path=Zoom, StringFormat={}{0:P0}}"/>
        </Grid>
        <local:PenEditorCanvas x:Name="canvas" Grid.Row="1" Grid.Column="0"
                               Image="{Binding BackgroundImage}"
                               DocumentImage="{Binding DocumentImage}"
                               CanvasWidth="{Binding CanvasWidth}"
                               CanvasHeight="{Binding CanvasHeight}"
                               WetInkColor="{Binding WetInkColor}"
                               WetInkThickness="{Binding WetInkThickness}"
                               WetInkUsesPressure="{Binding WetInkUsesPressure}"
                               StabilizationStrength="{Binding StabilizationStrength}"
                               IsEditable="{Binding IsLayerEditable}"
                               IsSelectionMode="{Binding IsSelectionMode}"
                               SelectionBounds="{Binding SelectionBounds}">
            <local:PenEditorCanvas.Style>
                <Style TargetType="local:PenEditorCanvas">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLayerEditable}" Value="False">
                            <Setter Property="ToolTip" Value="{x:Static local:Texts.LayerNotEditable}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </local:PenEditorCanvas.Style>
        </local:PenEditorCanvas>
        <GridSplitter Grid.Row="1" Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" Cursor="SizeWE"/>
        <Grid x:Name="layerPanel" Grid.Row="1" Grid.Column="2">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
                <DrawingBrush x:Key="ThumbnailBackgroundBrush" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Stretch="None">
                    <DrawingBrush.Drawing>
                        <DrawingGroup>
                            <GeometryDrawing Brush="#FF404040">
                                <GeometryDrawing.Geometry>
                                    <RectangleGeometry Rect="0,0,8,8"/>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                            <GeometryDrawing Brush="#FF505050">
                                <GeometryDrawing.Geometry>
                                    <GeometryGroup>
                                        <RectangleGeometry Rect="0,0,4,4"/>
                                        <RectangleGeometry Rect="4,4,4,4"/>
                                    </GeometryGroup>
                                </GeometryDrawing.Geometry>
                            </GeometryDrawing>
                        </DrawingGroup>
                    </DrawingBrush.Drawing>
                </DrawingBrush>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding AddLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.LayersPlus}}"
                        ToolTip="{x:Static local:Texts.AddLayer}"/>
                <Button Grid.Column="1" Command="{Binding AddFolderCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.FolderPlus}}"
                        ToolTip="{x:Static local:Texts.AddFolder}"/>
                <Button Grid.Column="2" Command="{Binding DuplicateLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ContentDuplicate}}"
                        ToolTip="{x:Static local:Texts.DuplicateLayer}"/>
                <Button Grid.Column="3" Command="{Binding MoveLayerUpCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ArrowUp}}"
                        ToolTip="{x:Static local:Texts.MoveLayerUp}"/>
                <Button Grid.Column="4" Command="{Binding MoveLayerDownCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ArrowDown}}"
                        ToolTip="{x:Static local:Texts.MoveLayerDown}"/>
                <Button Grid.Column="5" Command="{Binding MoveIntoFolderCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.FormatIndentIncrease}}"
                        ToolTip="{x:Static local:Texts.MoveIntoFolder}"/>
                <Button Grid.Column="6" Command="{Binding MoveOutOfFolderCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.FormatIndentDecrease}}"
                        ToolTip="{x:Static local:Texts.MoveOutOfFolder}"/>
                <Button Grid.Column="7" Command="{Binding DeleteLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.TrashCanOutline}}"
                        ToolTip="{x:Static local:Texts.DeleteLayer}"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding DisplayLayers}"
                     SelectedItem="{Binding ActiveLayer, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PenLayer}">
                        <Grid Height="26" Background="Transparent" MouseLeftButtonDown="OnLayerRowMouseLeftButtonDown">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition Width="26"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="{Binding IndentWidth}"/>
                            <Button Grid.Column="1" Padding="0" FontSize="9"
                                    Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}"
                                    Command="{Binding DataContext.ToggleExpandCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                    CommandParameter="{Binding}">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.ChevronRight}}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.ChevronDown}}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Border Grid.Column="2">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource ThumbnailBackgroundBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                <Setter Property="Background" Value="Transparent"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Image Source="{Binding Thumbnail}" Stretch="None"/>
                                    <ContentControl HorizontalAlignment="Center" VerticalAlignment="Center"
                                                    Content="{DynamicResource {x:Static icons:IconKeys.Folder}}"
                                                    Visibility="{Binding IsFolder, Converter={StaticResource BoolToVisibility}}"/>
                                </Grid>
                            </Border>
                            <ToggleButton Grid.Column="3" Padding="2" IsChecked="{Binding IsVisible}"
                                          ToolTip="{x:Static local:Texts.LayerVisible}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.EyeOffOutline}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Eye}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ToggleButton Grid.Column="4" Padding="2" IsChecked="{Binding IsLocked}"
                                          ToolTip="{x:Static local:Texts.LayerLocked}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.LockOpenVariantOutline}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Lock}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <Grid Grid.Column="5">
                                <TextBlock Padding="4,0,0,0" VerticalAlignment="Center"
                                           Text="{Binding Name}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Padding="4,0,0,0" VerticalAlignment="Center" BorderThickness="0"
                                         focus:FocusExtension.IsFocused="{Binding IsRenaming}"
                                         Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"
                                         LostKeyboardFocus="OnRenameLostKeyboardFocus"
                                         KeyDown="OnRenameKeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsRenaming}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerBlendMode}"/>
            <controls:EnumComboBox Grid.Row="3" Value="{Binding ActiveLayer.BlendMode, Mode=TwoWay}"
                                   EnumType="{x:Type project:Blend}"/>
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerOpacity}"/>
            <controls:TextBoxSlider Grid.Row="5" x:Name="layerOpacitySlider" Value="{Binding ActiveLayer.Opacity.Values[0].Value, Mode=TwoWay}"
                                    Min="0" Max="100" DefaultMin="0" DefaultMax="100" Unit="%"/>
            <Grid Grid.Row="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerClipping}"/>
                <controls:ToggleSlider Grid.Column="1" Value="{Binding ActiveLayer.IsClipping, Mode=TwoWay}"/>
            </Grid>
            <Grid Grid.Row="7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="60"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerRangeOverride}"
                           IsEnabled="{Binding IsRangeSupported}"/>
                <controls:ToggleSlider Grid.Column="1" Value="{Binding ActiveLayer.IsRangeOverridden, Mode=TwoWay}"
                                       IsEnabled="{Binding IsRangeSupported}"/>
            </Grid>
            <TextBlock Grid.Row="8" VerticalAlignment="Center" Text="{x:Static local:Texts.Length}"
                       IsEnabled="{Binding ActiveLayer.IsRangeOverridden}"/>
            <controls:TextBoxSlider Grid.Row="9" x:Name="layerLengthSlider" Value="{Binding ActiveLayer.Length.Values[0].Value, Mode=TwoWay}"
                                    Min="0" Max="100" DefaultMin="0" DefaultMax="100" Unit="%"
                                    IsEnabled="{Binding ActiveLayer.IsRangeOverridden}"/>
            <TextBlock Grid.Row="10" VerticalAlignment="Center" Text="{x:Static local:Texts.Offset}"
                       IsEnabled="{Binding ActiveLayer.IsRangeOverridden}"/>
            <controls:TextBoxSlider Grid.Row="11" x:Name="layerOffsetSlider" Value="{Binding ActiveLayer.Offset.Values[0].Value, Mode=TwoWay}"
                                    Min="-100" Max="100" DefaultMin="-100" DefaultMax="100" Unit="%"
                                    IsEnabled="{Binding ActiveLayer.IsRangeOverridden}"/>
        </Grid>
    </Grid>
</UserControl>
