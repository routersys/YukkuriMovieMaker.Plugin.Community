<UserControl x:Class="YukkuriMovieMaker.Plugin.Community.Shape.Pen.PenEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:YukkuriMovieMaker.Plugin.Community.Shape.Pen"
             xmlns:controls="clr-namespace:YukkuriMovieMaker.Controls;assembly=YukkuriMovieMaker.Controls"
             xmlns:icons="clr-namespace:YukkuriMovieMaker.Resources.Icons;assembly=YukkuriMovieMaker.Plugin"
             xmlns:project="clr-namespace:YukkuriMovieMaker.Project;assembly=YukkuriMovieMaker.Plugin"
             mc:Ignorable="d"
             d:DesignHeight="640" d:DesignWidth="1000"
             d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="240"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="26"/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Grid.ColumnSpan="2">
            <Grid.Resources>
                <Style x:Key="ToolButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
                <ContextMenu x:Key="PenContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.Pressure}" Command="{Binding TogglePenPressure}" IsChecked="{Binding Source={x:Static local:PenSettings.Default},Path=PenStyle.IsPressure}"/>
                </ContextMenu>
                <ContextMenu x:Key="HighlighterContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.Pressure}" Command="{Binding ToggleHighlighterPressure}" IsChecked="{Binding Source={x:Static local:PenSettings.Default},Path=HighlighterStyle.IsPressure}"/>
                </ContextMenu>
                <ContextMenu x:Key="EraserContextMenu" DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}" Placement="Bottom">
                    <MenuItem Header="{x:Static local:Texts.EraserByPoint}" Command="{Binding SelectEraserByPointCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=EraserStyle.Mode}" Value="Point">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                    <MenuItem Header="{x:Static local:Texts.EraserByStroke}" Command="{Binding SelectEraserByStrokeCommand}">
                        <MenuItem.Style>
                            <Style TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="IsChecked" Value="False"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source={x:Static local:PenSettings.Default},Path=EraserStyle.Mode}" Value="Line">
                                        <Setter Property="IsChecked" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </MenuItem.Style>
                    </MenuItem>
                </ContextMenu>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition MinWidth="26"/>
                <ColumnDefinition MaxWidth="100" MinWidth="26"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="26"/>
                <ColumnDefinition Width="26"/>
            </Grid.ColumnDefinitions>
            <ToggleButton Grid.Column="0" Command="{Binding SelectPenCommand}" ContextMenu="{StaticResource PenContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Pen}}"
                          ToolTip="{x:Static local:Texts.BallPen}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Pen">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="1" Padding="0" FontSize="5" ContextMenu="{StaticResource PenContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <ToggleButton Grid.Column="2" Command="{Binding SelectHighlighterCommand}" ContextMenu="{StaticResource HighlighterContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Marker}}"
                          ToolTip="{x:Static local:Texts.Highlighter}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Highlighter">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="3" Padding="0" FontSize="5" ContextMenu="{StaticResource HighlighterContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <ToggleButton Grid.Column="4" Command="{Binding SelectEraserCommand}" ContextMenu="{StaticResource EraserContextMenu}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Eraser}}"
                          ToolTip="{x:Static local:Texts.Eraser}">
                <ToggleButton.Style>
                    <Style TargetType="ToggleButton" BasedOn="{StaticResource ToolButtonStyle}">
                        <Setter Property="IsChecked" Value="False"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Eraser">
                                <Setter Property="IsChecked" Value="True"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ToggleButton.Style>
            </ToggleButton>
            <controls:DropDownButton Content="▼" Grid.Column="5" Padding="0" FontSize="5" ContextMenu="{StaticResource EraserContextMenu}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
            </controls:DropDownButton>
            <RepeatButton Grid.Column="6" Padding="4" Command="{Binding UndoCommand}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Undo}}"
                          ToolTip="{x:Static local:Texts.Undo}"/>
            <RepeatButton Grid.Column="7" Padding="4" Command="{Binding RedoCommand}"
                          Content="{DynamicResource {x:Static icons:IconKeys.Redo}}"
                          ToolTip="{x:Static local:Texts.Redo}"/>
            <controls:ColorPicker Grid.Column="8" Value="{Binding StrokeColor,Mode=TwoWay}"
                                  ToolTip="{x:Static local:Texts.StrokeColor}">
                <controls:ColorPicker.Style>
                    <Style TargetType="controls:ColorPicker" BasedOn="{StaticResource {x:Type controls:ColorPicker}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Mode}" Value="Eraser">
                                <Setter Property="IsEnabled" Value="False"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </controls:ColorPicker.Style>
            </controls:ColorPicker>
            <controls:TextBoxSlider Grid.Column="9" x:Name="strokeThicknessSlider" Value="{Binding StrokeThickness,Mode=TwoWay}"
                                    Min="0.1" Max="1024" DefaultMin="0.1" DefaultMax="10"
                                    ToolTip="{x:Static local:Texts.Thickness}"/>
            <Button Grid.Column="10" Command="{Binding ImportIsfCommand}"
                    Content="{DynamicResource {x:Static icons:IconKeys.Import}}"
                    ToolTip="{x:Static local:Texts.Import}"/>
            <controls:DropDownButton Grid.Column="11" Padding="4"
                                     Content="{DynamicResource {x:Static icons:IconKeys.Export}}"
                                     ToolTip="{x:Static local:Texts.Export}">
                <controls:DropDownButton.Style>
                    <Style TargetType="controls:DropDownButton" BasedOn="{StaticResource {x:Type ToggleButton}}"/>
                </controls:DropDownButton.Style>
                <controls:DropDownButton.ContextMenu>
                    <ContextMenu DataContext="{Binding RelativeSource={RelativeSource Mode=Self},Path=PlacementTarget.DataContext}" d:DataContext="{d:DesignInstance Type={x:Type local:PenEditorViewModel}}">
                        <MenuItem Header="{x:Static local:Texts.SaveImage}" Command="{Binding SaveImageCommand}"/>
                        <MenuItem Header="{x:Static local:Texts.ExportAsIsf}" Command="{Binding ExportIsfCommand}"/>
                    </ContextMenu>
                </controls:DropDownButton.ContextMenu>
            </controls:DropDownButton>
        </Grid>
        <local:PenEditorCanvas x:Name="canvas" Grid.Row="1" Grid.Column="0"
                               Image="{Binding BackgroundImage}"
                               DocumentImage="{Binding DocumentImage}"
                               WetInkColor="{Binding WetInkColor}"
                               WetInkThickness="{Binding WetInkThickness}"
                               WetInkUsesPressure="{Binding WetInkUsesPressure}"/>
        <Grid Grid.Row="1" Grid.Column="1">
            <Grid.Resources>
                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="Padding" Value="4"/>
                </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
                <RowDefinition Height="26"/>
                <RowDefinition/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
                <RowDefinition Height="20"/>
                <RowDefinition Height="26"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                    <ColumnDefinition MinWidth="26"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Command="{Binding AddLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.LayersPlus}}"
                        ToolTip="{x:Static local:Texts.AddLayer}"/>
                <Button Grid.Column="1" Command="{Binding DuplicateLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ContentDuplicate}}"
                        ToolTip="{x:Static local:Texts.DuplicateLayer}"/>
                <Button Grid.Column="2" Command="{Binding MoveLayerUpCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ArrowUp}}"
                        ToolTip="{x:Static local:Texts.MoveLayerUp}"/>
                <Button Grid.Column="3" Command="{Binding MoveLayerDownCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.ArrowDown}}"
                        ToolTip="{x:Static local:Texts.MoveLayerDown}"/>
                <Button Grid.Column="4" Command="{Binding DeleteLayerCommand}"
                        Content="{DynamicResource {x:Static icons:IconKeys.TrashCanOutline}}"
                        ToolTip="{x:Static local:Texts.DeleteLayer}"/>
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding DisplayLayers}"
                     SelectedItem="{Binding ActiveLayer, Mode=TwoWay}"
                     HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PenLayer}">
                        <Grid Height="24">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition Width="24"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <ToggleButton Grid.Column="0" Padding="2" IsChecked="{Binding IsVisible}"
                                          ToolTip="{x:Static local:Texts.LayerVisible}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.EyeOffOutline}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Eye}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <ToggleButton Grid.Column="1" Padding="2" IsChecked="{Binding IsLocked}"
                                          ToolTip="{x:Static local:Texts.LayerLocked}">
                                <ToggleButton.Style>
                                    <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                        <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.LockOpenVariantOutline}}"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Content" Value="{DynamicResource {x:Static icons:IconKeys.Lock}}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Style>
                            </ToggleButton>
                            <TextBlock Grid.Column="2" Padding="4,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="2" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerBlendMode}"/>
            <controls:EnumComboBox Grid.Row="3" Value="{Binding ActiveLayer.BlendMode, Mode=TwoWay}"
                                   EnumType="{x:Type project:Blend}"/>
            <TextBlock Grid.Row="4" VerticalAlignment="Center" Text="{x:Static local:Texts.LayerOpacity}"/>
            <controls:TextBoxSlider Grid.Row="5" x:Name="layerOpacitySlider" Value="{Binding ActiveLayer.Opacity.Values[0].Value, Mode=TwoWay}"
                                    Min="0" Max="100" DefaultMin="0" DefaultMax="100" Unit="%"/>
        </Grid>
    </Grid>
</UserControl>
